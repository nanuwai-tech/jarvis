# ==============================================================================
# JARVIS VOICE AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Gemini API Key (obtain from https://aistudio.google.com)
GOOGLE_API_KEY=your_gemini_api_key_here

# LiveKit Cloud Project Credentials (obtain from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Browser Tool Configuration (true = hidden browser, false = visible browser window)
HEADLESS_BROWSER=false
